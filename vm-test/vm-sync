#!/usr/bin/env bash
# Sync dun sources to a local test VM.
#
# Usage:
#   vm-test/vm-sync [REF]        clean `git archive` of REF (default HEAD)
#                                into ~/dun-<shortsha> on the VM; the remote
#                                directory is replaced if it already exists.
#   vm-test/vm-sync --worktree   rsync the current working tree (excluding
#                                target/, .git/, reference/, vm-test/) into
#                                ~/dun-worktree. For iteration only — binding
#                                measurements must use a clean REF sync.
#
# A leading `-t NAME` / `--target NAME` (or DUN_VM_TARGET) picks the VM;
# default is debian. Known targets: debian (2222), freebsd (2233).
# Prints the remote directory on success. Clean up remote directories after
# recording results (docs/debian-vm.md, docs/freebsd-vm.md).
set -euo pipefail

if [ "${1:-}" = "-t" ] || [ "${1:-}" = "--target" ]; then
    export DUN_VM_TARGET="${2:?vm-sync: -t requires a target name}"
    shift 2
fi

source "$(dirname "$0")/vm-common.sh"

if [ "${1:-}" = "--worktree" ]; then
    if ! ssh "${VM_SSH_OPTS[@]}" "$VM_DEST" 'command -v rsync >/dev/null'; then
        echo "vm-sync: rsync missing on the VM; install it first, e.g.:" >&2
        echo "  vm-test/vm-run -t $VM_TARGET sudo pkg install -y rsync   # FreeBSD" >&2
        echo "  vm-test/vm-run -t $VM_TARGET sudo apt-get install -y rsync   # Debian" >&2
        exit 1
    fi
    rsync -az --delete \
        --exclude 'target/' --exclude '/.git/' --exclude '/reference/' \
        --exclude '/vm-test/' --exclude '.DS_Store' \
        -e "ssh ${VM_SSH_OPTS[*]}" \
        "$REPO_ROOT/" "$VM_DEST:dun-worktree/"
    echo "synced working tree -> ~/dun-worktree ($VM_TARGET; not a clean commit; no binding measurements)"
    exit 0
fi

ref="${1:-HEAD}"
sha="$(git -C "$REPO_ROOT" rev-parse --short "$ref")"
dest="dun-$sha"

# `cd … && tar -xf -` is portable across GNU, BSD, and Solaris tar: Solaris
# tar reads a tape device unless given `-f -`, and its `-C` differs, so avoid
# both by changing directory first and reading stdin explicitly.
git -C "$REPO_ROOT" archive --format=tar "$ref" \
    | ssh "${VM_SSH_OPTS[@]}" "$VM_DEST" \
        "rm -rf ~/$dest && mkdir -p ~/$dest && cd ~/$dest && tar -xf -"

if [ "$ref" = "HEAD" ] && ! git -C "$REPO_ROOT" diff --quiet HEAD 2>/dev/null; then
    echo "note: local working tree is dirty; the archive contains only commit $sha" >&2
fi
echo "synced $ref ($sha) -> ~/$dest ($VM_TARGET)"
